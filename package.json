{
  "name": "demo-store",
  "private": true,
  "sideEffects": false,
  "version": "2.1.6",
  "type": "module",
  "scripts": {
    "dev": "shopify hydrogen dev",
    "dev:customer": "shopify hydrogen dev --customer-account-push",
    "build": "shopify hydrogen build --no-lockfile-check",
    "preview": "shopify hydrogen preview --build",
    "e2e": "npx playwright test",
    "e2e:ui": "npx playwright test --ui",
    "lint": "eslint --no-error-on-unmatched-pattern --ext .js,.ts,.jsx,.tsx .",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "typecheck": "react-router typegen && tsc --noEmit && gql.tada check",
    "gql:check": "gql.tada check"
  },
  "browserslist": [
    "defaults"
  ],
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@headlessui/react": "^1.7.2",
    "@shopify/cli": "3.94.3",
    "@shopify/hydrogen": "file:vendor/shopify-hydrogen-0.0.1.tgz",
    "@shopify/hydrogen-classic": "npm:@shopify/hydrogen@2026.4.2",
    "clsx": "^1.2.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.6.0",
    "graphql-tag": "^2.12.6",
    "isbot": "^5.1.22",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-intersection-observer": "^9.4.1",
    "react-router": "7.15.1",
    "react-router-dom": "7.15.1",
    "react-use": "^17.4.0",
    "schema-dts": "^1.1.0",
    "tiny-invariant": "^1.2.0",
    "typographic-base": "^1.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@react-router/dev": "7.15.1",
    "@react-router/fs-routes": "7.15.1",
    "@shopify/eslint-plugin": "^42.0.1",
    "@shopify/mini-oxygen": "4.1.0",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@shopify/prettier-config": "^1.1.2",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.9",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^8.4.10",
    "@types/node": "^22.8.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.20.0",
    "gql.tada": "^1.9.2",
    "postcss": "^8.4.21",
    "postcss-import": "^15.1.0",
    "postcss-preset-env": "^8.2.0",
    "prettier": "^2.8.4",
    "rimraf": "^3.0.2",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.2.2",
    "vite": "^8.0.1",
    "vite-tsconfig-paths": "^4.3.1"
  },
  "engines": {
    "node": "^22 || ^24"
  }
}
